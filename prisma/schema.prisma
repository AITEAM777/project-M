// Nodera data model.
//
// Design principles:
// - Every user-owned record lives inside a Workspace. Authorization is always
//   "is the caller a member of the record's workspace?".
// - Mind-map nodes are *placements* on a canvas. A node may reference a canonical
//   entity (note, task, goal, project, habit). Converting a node into a task creates
//   one Task and links it — the node never becomes an unrelated duplicate.
// - The same entity may appear on several maps (multiple contexts, no duplication).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
  TEAMS
}

enum MemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum NoteKind {
  NOTE
  THOUGHT
}

enum NodeKind {
  THOUGHT
  IDEA
  GOAL
  TASK
  PROJECT
  HABIT
  NOTE
  QUESTION
  DECISION
  RESOURCE
  MILESTONE
  GROUP
}

enum Relation {
  RELATED_TO
  DEPENDS_ON
  SUPPORTS
  BLOCKS
  PART_OF
  REQUIRES
  CONFLICTS_WITH
  COMBINES_WITH
  LEADS_TO
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum GoalStatus {
  NOT_STARTED
  ACTIVE
  ON_HOLD
  COMPLETED
  ABANDONED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum HabitFrequency {
  DAILY
  WEEKLY
}

enum Recurrence {
  NONE
  DAILY
  WEEKDAYS
  WEEKLY
  MONTHLY
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  plan         Plan     @default(FREE)
  theme        String   @default("system")
  locale       String   @default("en")
  aiEnabled    Boolean  @default(true)
  onboardedAt  DateTime?
  emailVerifiedAt DateTime?
  dashboardLayout Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]
  memberships  WorkspaceMember[]
  ownedSpaces  Workspace[]       @relation("WorkspaceOwner")
  activities   Activity[]
  reminders    Reminder[]
  suggestions  AiSuggestion[]
  subscriptions Subscription[]
  payments     Payment[]
  adminSessions AdminSession[]
}

model Session {
  id        String   @id // sha256 hash of the cookie token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  icon      String   @default("🧠")
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     WorkspaceMember[]
  folders     Folder[]
  notes       Note[]
  maps        MindMap[]
  projects    Project[]
  goals       Goal[]
  tasks       Task[]
  habits      Habit[]
  events      CalendarEvent[]
  attachments Attachment[]
  activities  Activity[]
  suggestions AiSuggestion[]

  @@index([ownerId])
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        MemberRole @default(OWNER)
  createdAt   DateTime   @default(now())
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model Folder {
  id          String    @id @default(cuid())
  workspaceId String
  parentId    String?
  name        String
  color       String    @default("#6366f1")
  icon        String    @default("📁")
  position    Int       @default(0)
  favorite    Boolean   @default(false)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Folder?   @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]  @relation("FolderTree")
  notes     Note[]
  maps      MindMap[]
  projects  Project[]
  goals     Goal[]

  @@index([workspaceId, parentId])
}

model Note {
  id          String    @id @default(cuid())
  workspaceId String
  folderId    String?
  kind        NoteKind  @default(NOTE)
  title       String    @default("Untitled")
  content     Json?     // rich-text document (TipTap/ProseMirror JSON)
  contentText String    @default("") // plain text projection used for search
  tags        String[]  @default([])
  favorite    Boolean   @default(false)
  archivedAt  DateTime?
  createdById String?
  lastOpenedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder      Folder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  nodes       MapNode[]
  attachments Attachment[]
  linksOut    NoteLink[]   @relation("LinkSource")
  linksIn     NoteLink[]   @relation("LinkTarget")
  versions    NoteVersion[]

  @@index([workspaceId, updatedAt])
  @@index([workspaceId, folderId])
  @@index([tags], type: Gin)
}

// Internal [[links]] between notes, derived from note content on save.
model NoteLink {
  sourceId String
  targetId String
  source   Note   @relation("LinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target   Note   @relation("LinkTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([sourceId, targetId])
  @@index([targetId])
}

// Lightweight version history (snapshots taken at most every few minutes).
model NoteVersion {
  id        String   @id @default(cuid())
  noteId    String
  title     String
  content   Json?
  createdAt DateTime @default(now())
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, createdAt])
}

model MindMap {
  id          String    @id @default(cuid())
  workspaceId String
  folderId    String?
  title       String    @default("Untitled map")
  description String    @default("")
  viewport    Json?
  favorite    Boolean   @default(false)
  archivedAt  DateTime?
  lastOpenedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder    Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  nodes     MapNode[]
  edges     MapEdge[]

  @@index([workspaceId, updatedAt])
  @@index([workspaceId, folderId])
}

model MapNode {
  id          String   @id // client-generated stable id (allows optimistic creation)
  mapId       String
  kind        NodeKind @default(THOUGHT)
  title       String   @default("")
  description String   @default("")
  color       String   @default("")
  shape       String   @default("rounded") // rounded | pill | rectangle | circle | diamond
  icon        String   @default("")
  x           Float    @default(0)
  y           Float    @default(0)
  width       Float?
  height      Float?
  collapsed   Boolean  @default(false)
  parentId    String?  // group container node id (React Flow sub-flow)
  tags        String[] @default([])
  links       String[] @default([]) // external URLs

  // References to canonical entities — a node *points at* data, never copies it.
  noteId    String?
  taskId    String?
  goalId    String?
  projectId String?
  habitId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  map     MindMap  @relation(fields: [mapId], references: [id], onDelete: Cascade)
  note    Note?    @relation(fields: [noteId], references: [id], onDelete: SetNull)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  goal    Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  habit   Habit?   @relation(fields: [habitId], references: [id], onDelete: SetNull)
  attachments Attachment[]

  outgoing MapEdge[] @relation("EdgeSource")
  incoming MapEdge[] @relation("EdgeTarget")

  @@index([mapId])
  @@index([noteId])
  @@index([taskId])
  @@index([goalId])
  @@index([projectId])
  @@index([habitId])
}

model MapEdge {
  id            String   @id
  mapId         String
  sourceId      String
  targetId      String
  sourceHandle  String?
  targetHandle  String?
  relation      Relation @default(RELATED_TO)
  label         String   @default("")
  description   String   @default("")
  bidirectional Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  map    MindMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  source MapNode @relation("EdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target MapNode @relation("EdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([mapId])
  @@index([sourceId])
  @@index([targetId])
}

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  folderId    String?
  goalId      String?
  title       String
  description String        @default("")
  status      ProjectStatus @default(ACTIVE)
  color       String        @default("#6366f1")
  startDate   DateTime?
  dueDate     DateTime?
  favorite    Boolean       @default(false)
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder    Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  goal      Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  tasks     Task[]
  nodes     MapNode[]

  @@index([workspaceId, status])
  @@index([goalId])
}

model Goal {
  id              String     @id @default(cuid())
  workspaceId     String
  folderId        String?
  title           String
  description     String     @default("")
  category        String     @default("")
  priority        Priority   @default(MEDIUM)
  status          GoalStatus @default(ACTIVE)
  startDate       DateTime?
  targetDate      DateTime?
  motivation      String     @default("")
  successCriteria String     @default("")
  autoProgress    Boolean    @default(true)
  manualProgress  Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder     Folder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)
  milestones Milestone[]
  tasks      Task[]
  projects   Project[]
  habits     Habit[]
  nodes      MapNode[]
  events     EventGoal[]
  dependsOn  GoalDependency[] @relation("GoalDependent")
  dependents GoalDependency[] @relation("GoalDependency")

  @@index([workspaceId, status])
}

model GoalDependency {
  goalId      String
  dependsOnId String
  goal        Goal   @relation("GoalDependent", fields: [goalId], references: [id], onDelete: Cascade)
  dependsOn   Goal   @relation("GoalDependency", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([goalId, dependsOnId])
}

model Milestone {
  id          String    @id @default(cuid())
  goalId      String
  title       String
  done        Boolean   @default(false)
  dueDate     DateTime?
  position    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  goal  Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([goalId])
}

model Task {
  id              String     @id @default(cuid())
  workspaceId     String
  projectId       String?
  goalId          String?
  milestoneId     String?
  title           String
  description     String     @default("")
  status          TaskStatus @default(TODO)
  priority        Priority   @default(MEDIUM)
  tags            String[]   @default([])
  dueDate         DateTime?
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  estimateMinutes Int?
  actualMinutes   Int?
  recurrence      Recurrence @default(NONE)
  position        Int        @default(0)
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  goal      Goal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  nodes     MapNode[]
  events    CalendarEvent[]
  reminders Reminder[]
  dependsOn  TaskDependency[] @relation("TaskDependent")
  dependents TaskDependency[] @relation("TaskDependency")

  @@index([workspaceId, status])
  @@index([workspaceId, dueDate])
  @@index([workspaceId, scheduledStart])
  @@index([projectId])
  @@index([goalId])
  @@index([tags], type: Gin)
}

model TaskDependency {
  taskId      String
  dependsOnId String
  task        Task   @relation("TaskDependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task   @relation("TaskDependency", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
}

model Habit {
  id              String         @id @default(cuid())
  workspaceId     String
  goalId          String?
  title           String
  description     String         @default("")
  icon            String         @default("✨")
  color           String         @default("#10b981")
  frequency       HabitFrequency @default(DAILY)
  targetPerPeriod Int            @default(1) // completions per day (DAILY) or per week (WEEKLY)
  unit            String         @default("times")
  reminderTime    String?        // "HH:mm" local time
  archivedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goal      Goal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  logs      HabitLog[]
  nodes     MapNode[]
  events    CalendarEvent[]
  reminders Reminder[]

  @@index([workspaceId])
}

model HabitLog {
  id      String   @id @default(cuid())
  habitId String
  date    DateTime @db.Date
  count   Int      @default(1)
  habit   Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

model CalendarEvent {
  id          String     @id @default(cuid())
  workspaceId String
  title       String
  description String     @default("")
  start       DateTime
  end         DateTime
  allDay      Boolean    @default(false)
  color       String     @default("#6366f1")
  category    String     @default("")
  recurrence  Recurrence @default(NONE)
  recurUntil  DateTime?
  taskId      String?
  habitId     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  habit     Habit?      @relation(fields: [habitId], references: [id], onDelete: SetNull)
  goals     EventGoal[] // an activity may contribute to several goals
  reminders Reminder[]

  @@index([workspaceId, start])
}

model EventGoal {
  eventId String
  goalId  String
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  goal    Goal          @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@id([eventId, goalId])
  @@index([goalId])
}

model Reminder {
  id        String    @id @default(cuid())
  userId    String
  title     String
  remindAt  DateTime
  firedAt   DateTime?
  readAt    DateTime?
  taskId    String?
  habitId   String?
  eventId   String?
  createdAt DateTime  @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  task  Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  habit Habit?         @relation(fields: [habitId], references: [id], onDelete: Cascade)
  event CalendarEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, remindAt])
}

model Attachment {
  id          String   @id @default(cuid())
  workspaceId String
  noteId      String?
  nodeId      String?
  filename    String
  mimeType    String
  size        Int
  storageKey  String   @unique
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  note      Note?     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  node      MapNode?  @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([noteId])
  @@index([nodeId])
}

model Activity {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  action      String   // created | updated | deleted | completed | converted ...
  entityType  String   // note | map | node | task | goal | project | habit | event | folder
  entityId    String
  summary     String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

model AiSuggestion {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String
  kind        String           // plan | connections | tags | summary | reflection
  input       String           @default("")
  payload     Json
  status      SuggestionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  resolvedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// ── Accounts & billing ──────────────────────────────────────────────────────

/** One-time 6-digit codes sent by email (sign-up, password reset, admin sign-in). */
model EmailCode {
  id         String    @id @default(cuid())
  email      String
  purpose    String    // signup | reset | admin
  codeHash   String
  payload    Json?     // signup: { name, passwordHash, locale } until the code is confirmed
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
}

/** Fixed-window counters shared by every server instance. */
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String
  plan             Plan
  period           String             // month | year | manual
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime
  cancelAtPeriodEnd Boolean           @default(false)
  provider         String             @default("manual") // manual | wayforpay | liqpay | paddle …
  providerRef      String?
  note             String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, currentPeriodEnd])
}

model Payment {
  id          String   @id @default(cuid())
  userId      String?
  amount      Int      // minor units (kopecks / cents)
  fee         Int      @default(0)
  currency    String   @default("UAH")
  status      String   // paid | failed | refunded
  plan        Plan?
  period      String?
  provider    String
  providerRef String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}

model AdminSession {
  id        String   @id // sha256 of the cookie token
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdminLog {
  id        String   @id @default(cuid())
  email     String
  action    String   // login | login_failed | grant_plan | revoke_plan | logout_user | export
  target    String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
