# PostgreSQL connection string (required)
DATABASE_URL="postgresql://nodera:nodera@localhost:5432/nodera?schema=public"

# Public base URL of the app (used for cookies / links)
APP_URL="http://localhost:3000"

# Directory where uploaded attachments are stored (server-side only)
UPLOAD_DIR="./uploads"
# Max upload size in bytes (default 10 MB)
MAX_UPLOAD_BYTES="10485760"

# Optional: enables the AI assistant (Phase 3). Leave empty to disable AI entirely.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"

# ── Email & security ─────────────────────────────────────────────────────────
# Sends 6-digit codes (sign-up, password reset, admin sign-in) via resend.com.
# Without it sign-up works without email confirmation and password reset is hidden.
RESEND_API_KEY=""
MAIL_FROM="Nodera <hello@noderamind.com>"
# Local development / e2e only: show codes on screen instead of emailing them.
# Ignored on Vercel production.
AUTH_DEV_CODES=""

# Comma-separated emails allowed into the admin panel at admin.<your-domain>.
ADMIN_EMAILS=""
# Optional: protects /api/cron/daily (Vercel sends it automatically when set).
CRON_SECRET=""
