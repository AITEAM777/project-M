# PostgreSQL connection string (required)
DATABASE_URL="postgresql://nodera:nodera@localhost:5432/nodera?schema=public"

# Public base URL of the app (used for cookies / links)
APP_URL="http://localhost:3000"

# Directory where uploaded attachments are stored (server-side only)
UPLOAD_DIR="./uploads"
# Max upload size in bytes (default 10 MB)
MAX_UPLOAD_BYTES="10485760"

# Optional: enables the AI assistant (Phase 3). Leave empty to disable AI entirely.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"
